# Helper Functions
    getDesktopManager_v1() {
        ssh "${SSH_LOGIN}" \
        "loginctl show-session \$(loginctl | awk '/tty|seat/ {print \$1; exit}') -p Type --value"
    }

    getDesktopManager_v2() {
        ssh "${SSH_LOGIN}" \
        "loginctl list-sessions --no-legend | awk 'NR==1 {print \$1}' | xargs -I{} loginctl show-session {} -p Type --value"
    }

    reboot_wait() {
        local host="${1:-$HOST_NAME}"
        local user="${2:-$USER}"
        local timeout="${3:-180}"
        local interval=3
        local elapsed=0

        echo -e "${Y}          ╰⸺▶ ${INFO}Rebooting Device"

        ssh "${user}@${host}" "sudo reboot"
        sleep 1

        printf  "${B}          ╰⸺▶ ${INFO}Waiting for device online."


        # Phase 1: wait for SSH to accept connections
        while ! ssh -o ConnectTimeout=3 \
                    -o BatchMode=yes \
                    -o StrictHostKeyChecking=no \
                    "${user}@${host}" "exit" 2>/dev/null; do

            printf "."
            sleep "$interval"
            ((elapsed+=interval))

            if (( elapsed >= timeout )); then
                echo -e "${NC}"
                return 1
            fi
        done

        echo -e "${NC}"

        # Reset timer for next phase
        elapsed=0

        # Phase 2: wait for systemd to report fully running
        while true; do
            state=$(ssh -o ConnectTimeout=3 \
                        -o BatchMode=yes \
                        "${user}@${host}" "systemctl is-system-running" 2>/dev/null)

            if [[ "$state" == "running" ]]; then
                return 0
            fi

            sleep "$interval"
            ((elapsed+=interval))

            if (( elapsed >= timeout )); then
                log_error "Systemctl not responding"
                ext_error "Last Known State: $state"
                return 1
            fi
        done
    }

    reboot_device() {
        ssh "${SSH_LOGIN}" "sudo reboot"
    }
#

create_program_fs() {
    log_info "Setting up program file system"
    sleep 1

    # Check for Existing Temporary Directory [~/TMP_ndpi]
        if ssh "${SSH_LOGIN}" "[ -d '${REMOTE_DIR_TMP}' ]"; then
            ext_success "TMP directory already exists"
        else
            log_info "Creating TMP directory on device:${NC} ${Y}${REMOTE_DIR_TMP}"
            ext_info "${REMOTE_DIR_TMP}"
            if ! ssh "${SSH_LOGIN}" "
                set -e
                sudo mkdir -p '${REMOTE_DIR_TMP}'
                sudo chown '${USER}':'${USER}' '${REMOTE_DIR_TMP}'
            "; then
                log_error "Failed to create TMP directory on device."
                exit 1
            fi
        fi
    #
    sleep 1

    # Clone Program GitHub Repo into Temporary Directory [~/TMP_ndpi]
        if ssh "${SSH_LOGIN}" "[ -d '${REMOTE_DIR_TMP}/.git' ]"; then
            ext_success "GitHub repo already cloned."
        else
            ext_info "Cloning GitHub repo into TMP"
            ext_info "${REPO_URL}"
            if ! ssh "${SSH_LOGIN}" "
                set -e
                git clone \
                    --branch \
                    '${BRANCH}' \
                    '${REPO_URL}' \
                    '${REMOTE_DIR_TMP}' \
                    &>/dev/null
                sudo chown -R '${USER}':'${USER}' '${REMOTE_DIR_TMP}'
                sudo chmod +x ${REMOTE_DIR_TMP}/sh/*
            "; then
                log_error "Failed to clone repo from GitHub."
                exit 1
            fi
        fi
    #
    sleep 2


    # Check for Existing Program Directory [~/ndpi]
        if ssh "${SSH_LOGIN}" "[ -d '${REMOTE_DIR_PGM}' ]"; then
            ext_success "Program directory already exists."
        else
            log_info "Creating program directory on device:${NC} ${Y}${REMOTE_DIR_PGM}"
            ext_info "${REMOTE_DIR_PGM}"
            if ! ssh "${SSH_LOGIN}" "
                set -e
                sudo mkdir -p '${REMOTE_DIR_PGM}'
                sudo chown '${USER}':'${USER}' '${REMOTE_DIR_PGM}'
            "; then
                log_error "Failed to create program directory on device."
                exit 1
            else
                log_success "Program directory created"
            fi
        fi
    #
    sleep 1

    # Sync Program Directory [~/ndpi] with Temporary Directory [~/TMP_ndpi]
        ext_info "Moving program files from TMP to program directory."
        if ! ssh "${SSH_LOGIN}" "
            set -e
            sudo rsync \
                --archive \
                --itemize-changes \
                --verbose \
                --no-perms \
                --delete \
                --exclude=.git \
                --exclude=.gitignore \
                ${REMOTE_DIR_TMP}/ ${REMOTE_DIR_PGM}
        "; then
            log_error "Failed to transfer program files."
            exit 1
        fi
    #
    sleep 2


    # chmod +x sh/ scripts
        log_info "Applying exec permission to scripts"
        if ! ssh "${SSH_LOGIN}" "
            set -e
            sudo chmod +x ${REMOTE_DIR_PGM}/sh/*
        "; then
            log_error "Failed to apply exec permission to scripts"
            exit 1
        fi
    #

    log_success "Program File System Imported"
}

create_program_fs